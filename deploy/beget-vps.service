[Unit]
Description=Svoi Ryady FastAPI application
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/svoi-ryady
EnvironmentFile=/var/www/svoi-ryady/.env
ExecStart=/var/www/svoi-ryady/.venv/bin/gunicorn main:app -k uvicorn.workers.UvicornWorker --workers 2 --bind 127.0.0.1:8000 --timeout 120
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
